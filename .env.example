# Get a free key at https://build.nvidia.com (sign in → any Nemotron model → "Get API Key")
NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides. Run `npm run check` to see which Nemotron models your key can use
# and get a suggested set of values for this file.
# NEMOTRON_FAST_MODEL=nvidia/nvidia-nemotron-nano-9b-v2      # or nvidia/nemotron-3-nano-30b-a3b
# NEMOTRON_DEEP_MODEL=nvidia/nemotron-3-super-120b-a12b      # or nvidia/nemotron-3.5-super-vl-120b-a12b
# NEMOTRON_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1         # OpenRouter: https://openrouter.ai/api/v1

# Reasoning: off | on | low (on + ~512-token budget) | <token budget>
# Nemotron 3/3.5 use chat_template_kwargs.enable_thinking; Nano 9B v2 uses /think and /no_think.
# NEMOTRON_FAST_THINKING=off
# NEMOTRON_DEEP_THINKING=low
# NEMOTRON_VISION_THINKING=off
# NEMOTRON_REASONING_CONTROL=                                 # force: chat_template_kwargs | system_prompt | detailed_thinking | openrouter | none

# Latency budget (ms). Every analysis ends with a verdict inside NEMOTRON_RUN_BUDGET_MS;
# if the model is slow the rules finish the run with the evidence already gathered.
# NEMOTRON_RUN_BUDGET_MS=25000
# NEMOTRON_FAST_TIMEOUT_MS=8000
# NEMOTRON_DEEP_TIMEOUT_MS=15000
# NEMOTRON_DEEP_MAX_TOKENS=2048
# NEMOTRON_FAST_MAX_TOKENS=300

# OpenRouter attribution headers (sent only when NVIDIA_BASE_URL is openrouter.ai)
# OPENROUTER_REFERER=https://github.com/your/repo
# OPENROUTER_TITLE=Second Look
